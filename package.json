{
  "name": "ielts-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare:reading && npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node server-dist/index.js",
    "prepare:reading": "node scripts/prepare-reading-data.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node tests/reading-browser.mjs"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.13"
  }
}
